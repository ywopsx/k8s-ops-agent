{
  "permissions": {
    "allow": [
      "Bash(python3 -m pytest *)",
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(kubectl get *)",
      "Bash(kubectl config current-context)",
      "Bash(kind get *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(kubectl delete *)",
      "Bash(kind delete *)",
      "Bash(./demo/run-demo.sh)",
      "Bash(./demo/*.sh)",
      "Bash(kubectl cordon *)",
      "Bash(kubectl uncordon *)",
      "Bash(kubectl create --raw *)",
      "Bash(python3 -m rehearsal *)",
      "Bash(.venv/bin/python -m rehearsal *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.kube/**)",
      "Read(~/.aws/**)"
    ]
  }
}
