{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "metadata": {
        "name": "order-api",
        "namespace": "shop"
      },
      "spec": {
        "replicas": 3,
        "template": {
          "spec": {
            "nodeSelector": {
              "node-role": "app"
            }
          }
        }
      }
    },
    {
      "metadata": {
        "name": "legacy-batch",
        "namespace": "shop"
      },
      "spec": {
        "replicas": 1,
        "template": {
          "spec": {
            "nodeSelector": {
              "eks.amazonaws.com/nodegroup": "ng-legacy"
            }
          }
        }
      }
    }
  ]
}