{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "metadata": {
        "name": "aws-node",
        "namespace": "kube-system"
      },
      "spec": {
        "template": {
          "spec": {
            "containers": [
              {
                "name": "aws-node",
                "env": [
                  {
                    "name": "AWS_VPC_K8S_CNI_CUSTOM_NETWORK_CFG",
                    "value": "false"
                  },
                  {
                    "name": "ENABLE_PREFIX_DELEGATION",
                    "value": "true"
                  },
                  {
                    "name": "ENI_CONFIG_LABEL_DEF",
                    "value": "topology.kubernetes.io/zone"
                  }
                ]
              }
            ]
          }
        }
      }
    }
  ]
}